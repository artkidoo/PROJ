{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:security": "tsx test-pilot-security.ts",
    "test:firestore-rules": "tsx tests/firestore.rules.test.ts",
    "test:firestore-phase3c": "tsx tests/firestore.phase3c.rules.test.ts",
    "test:storage-rules": "tsx tests/storage.rules.test.ts",
    "test:functions": "tsx tests/functions.test.ts",
    "test:firebase": "npm run test:firestore-rules && npm run test:firestore-phase3c && npm run test:storage-rules && npm run test:functions",
    "emulators:start": "firebase emulators:start --only auth,firestore,storage,functions --project demo-keedohub --ui",
    "emulators:stop": "firebase emulators:stop",
    "emulators:log": "firebase emulators:start --only auth,firestore,storage,functions --project demo-keedohub --ui --inspect-functions --export-on-exit",
    "test": "npm run emulators:start & sleep 5 && npm run test:firebase && npm run emulators:stop"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "chai": "^5.3.3",
    "esbuild": "^0.25.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "firebase-functions-test": "^3.4.1",
    "mocha": "^12.0.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
