rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isWorkspaceAccountActive() {
      return isSignedIn() &&
        (!firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)) ||
          !firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.keys().hasAny(['status', 'Status']) ||
          ((!firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.keys().hasAny(['status']) ||
            !(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.status is string) ||
            !(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.status.trim().lower() in ['suspended', 'revoked', 'disabled'])) &&
           (!firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.keys().hasAny(['Status']) ||
            !(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.Status is string) ||
            !(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.Status.trim().lower() in ['suspended', 'revoked', 'disabled']))));
    }

    function isWorkspaceOpen(workspaceId) {
      return workspaceId is string &&
        firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)) &&
        (!firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)).data.keys().hasAny(['status']) ||
          firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)).data.status in ['Active', 'Onboarding']);
    }

    function ownsProjectWorkspace(workspaceId) {
      return workspaceId is string &&
        isWorkspaceOpen(workspaceId) &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function ownsClientProject(projectId) {
      return isSignedIn() &&
        isWorkspaceAccountActive() &&
        firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)) &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)).data.clientUid == request.auth.uid &&
        (
          (firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)).data.keys().hasAny(['workspaceId']) &&
            ownsProjectWorkspace(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)).data.workspaceId)) ||
          (!firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)).data.keys().hasAny(['workspaceId']) &&
            firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)) &&
            firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId is string &&
            ownsProjectWorkspace(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId))
        );
    }

    // Fail-Safe Workspace Ownership Check
    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() && 
        firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)) &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid &&
        isWorkspaceAccountActive() &&
        isWorkspaceOpen(workspaceId);
    }

    // Fail-Safe Cross-Service Workspace Membership Check (Enforcing Active Status)
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && (
        (
          firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)/memberships/$(request.auth.uid)) &&
          firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)/memberships/$(request.auth.uid)).data.status == 'Active' &&
          isWorkspaceAccountActive() &&
          isWorkspaceOpen(workspaceId)
        ) ||
        isWorkspaceOwner(workspaceId) ||
        isPlatformAdmin()
      );
    }

    function hasPlatformAdminRole(adminData) {
      return (adminData.keys().hasAny(['role']) &&
        adminData.role is string &&
        adminData.role.trim().lower() in ['platformadmin', 'platform admin', 'superadmin', 'super admin']) ||
        (adminData.keys().hasAny(['Role']) &&
        adminData.Role is string &&
        adminData.Role.trim().lower() in ['platformadmin', 'platform admin', 'superadmin', 'super admin']);
    }

    function isAdminRecordActive(adminData) {
      return hasPlatformAdminRole(adminData) &&
        (!adminData.keys().hasAny(['status']) ||
          !(adminData.status is string) ||
          !(adminData.status.trim().lower() in ['suspended', 'revoked', 'inactive', 'disabled'])) &&
        (!adminData.keys().hasAny(['Status']) ||
          !(adminData.Status is string) ||
          !(adminData.Status.trim().lower() in ['suspended', 'revoked', 'inactive', 'disabled'])) &&
        (!adminData.keys().hasAny(['revoked']) || adminData.revoked != true) &&
        (!adminData.keys().hasAny(['suspended']) || adminData.suspended != true) &&
        (!adminData.keys().hasAny(['active']) || adminData.active != false) &&
        (!adminData.keys().hasAny(['Active']) || adminData.Active != false);
    }

    function isPlatformAdmin() {
      return isSignedIn() &&
        isWorkspaceAccountActive() &&
        firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/admins/$(request.auth.uid)) &&
        isAdminRecordActive(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/admins/$(request.auth.uid)).data);
    }

    function ownsPublishedDeliverable(projectId, deliverableId) {
      return ownsClientProject(projectId) &&
        firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)/deliverables/$(deliverableId)) &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)/deliverables/$(deliverableId)).data.clientUid == request.auth.uid &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)/deliverables/$(deliverableId)).data.isClientPublished == true;
    }

    // Explicit Creative Asset MIME Allowlist (includes Adobe PSD & print/package deliverable formats)
    function isValidCreativeAsset() {
      return request.resource.contentType.matches(
        '^(image/(jpeg|png|svg\\+xml|webp|gif|avif|vnd\\.adobe\\.photoshop)|application/(pdf|json|xml|zip|x-zip-compressed|font-woff|x-photoshop|photoshop)|audio/(mpeg|wav|x-wav|aac|flac|mp4|m4a|ogg)|video/(mp4|webm|quicktime)|font/(ttf|otf|woff|woff2)|text/(plain|xml))$'
      );
    }

    function isArtistAccountType(rawType) {
      return rawType is string && rawType.trim().lower() == 'artist';
    }

    function isBrandAccountType(rawType) {
      return rawType is string &&
        rawType.trim().lower() in [
          'brand', 'company', 'business', 'label', 'agency',
          'enterprise', 'personal', 'startup', 'corporation', 'commercial'
        ];
    }

    function clientMatchesProductAudience(audience) {
      return isSignedIn() &&
        firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)) &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.onboardingComplete == true &&
        (
          audience == 'Shared' ||
          (isArtistAccountType(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.accountType) &&
            audience == 'Artist') ||
          (isBrandAccountType(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.accountType) &&
            audience in ['Brand', 'Business', 'Brand & Business'])
        );
    }

    function isServicePackageActive(packageId) {
      return packageId is string &&
        packageId.size() > 0 &&
        packageId.size() <= 128 &&
        packageId.matches('^[a-zA-Z0-9_\\-]+$') &&
        firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/services/$(packageId)) &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/services/$(packageId)).data.isActive == true;
    }

    function clientHasOpenProductWorkspace() {
      return isSignedIn() &&
        firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)) &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId is string &&
        isWorkspaceOpen(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId) &&
        (
          firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.ownerId == request.auth.uid ||
          (
            firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)/memberships/$(request.auth.uid)) &&
            firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)/memberships/$(request.auth.uid)).data.status == 'Active'
          )
        );
    }

    function clientMatchesPackageAt(productPkgIds, wsPkgIds, idx) {
      return wsPkgIds.size() > idx &&
        wsPkgIds[idx] is string &&
        wsPkgIds[idx].size() > 0 &&
        (wsPkgIds[idx] in productPkgIds) &&
        isServicePackageActive(wsPkgIds[idx]);
    }

    function clientHasActivePackageForProduct(productId) {
      return clientHasOpenProductWorkspace() &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.keys().hasAny(['includedPackageIds']) &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.includedPackageIds is list &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.includedPackageIds.size() > 0 &&
        (
          (
            firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.keys().hasAny(['activePackageIds']) &&
            firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.activePackageIds is list &&
            firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.includedPackageIds.hasAny(
              firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.activePackageIds
            )
          ) ||
          (
            !firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.keys().hasAny(['activePackageIds']) &&
            firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.keys().hasAny(['contractedPackageIds']) &&
            firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds is list &&
            firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds.size() > 0 &&
            (
              clientMatchesPackageAt(
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.includedPackageIds,
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds,
                0
              ) ||
              clientMatchesPackageAt(
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.includedPackageIds,
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds,
                1
              ) ||
              clientMatchesPackageAt(
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.includedPackageIds,
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds,
                2
              ) ||
              clientMatchesPackageAt(
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.includedPackageIds,
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds,
                3
              ) ||
              clientMatchesPackageAt(
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.includedPackageIds,
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds,
                4
              ) ||
              clientMatchesPackageAt(
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.includedPackageIds,
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds,
                5
              ) ||
              clientMatchesPackageAt(
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.includedPackageIds,
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds,
                6
              ) ||
              clientMatchesPackageAt(
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.includedPackageIds,
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds,
                7
              ) ||
              clientMatchesPackageAt(
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.includedPackageIds,
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds,
                8
              ) ||
              clientMatchesPackageAt(
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.includedPackageIds,
                firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds,
                9
              )
            )
          )
        );
    }

    function clientHasWorkspaceAssignmentForProduct(productId) {
      return clientHasOpenProductWorkspace() &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.keys().hasAny(['assignedWorkspaceIds']) &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.assignedWorkspaceIds is list &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId in firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.assignedWorkspaceIds;
    }

    function canClientViewProductPreview(productId) {
      return isWorkspaceAccountActive() &&
        clientHasOpenProductWorkspace() &&
        firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)) &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.status == 'Published' &&
        clientMatchesProductAudience(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.audience) &&
        (
          firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.accessType in ['Free', 'RequestRequired'] ||
          firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.get('unlockedByDefault', false) == true ||
          clientHasWorkspaceAssignmentForProduct(productId) ||
          (
            firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.accessType == 'IncludedInPackage' &&
            clientHasActivePackageForProduct(productId)
          )
        );
    }

    function canClientDownloadProductDeliverable(productId) {
      return canClientViewProductPreview(productId) && (
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.accessType == 'Free' ||
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.get('unlockedByDefault', false) == true ||
        clientHasWorkspaceAssignmentForProduct(productId) ||
        (
          firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/creativeProducts/$(productId)).data.accessType == 'IncludedInPackage' &&
          clientHasActivePackageForProduct(productId)
        )
      );
    }

    // Operator Internal Notes & Confidential Staging (Restricted to Platform Admins)
    match /workspaces/{workspaceId}/internal/{allPaths=**} {
      allow read, write: if isPlatformAdmin();
    }

    // Workspace Shared Files Path (Multi-Tenant Authorization, Volumetric & Content-Type Guards)
    // Explicitly excludes the 'internal' top-level folder so overlapping rules cannot grant members internal access.
    match /workspaces/{workspaceId}/{topFolder}/{allPaths=**} {
      allow read: if topFolder != 'internal' && isWorkspaceMember(workspaceId);
      
      allow create, update: if topFolder != 'internal' &&
        isWorkspaceMember(workspaceId) && 
        request.resource.size < 50 * 1024 * 1024 && // Enforce 50MB maximum asset size limit
        isValidCreativeAsset();                     // Strict MIME allowlist validation
        
      allow delete: if topFolder != 'internal' && isWorkspaceMember(workspaceId);
    }

    // Legacy client deliverables remain private to their owner and platform admins.
    match /clients/{clientUid}/deliverables/{deliverableId}/{fileName} {
      // Only the active owner client or platform admin can read
      allow read: if isPlatformAdmin() || (isWorkspaceAccountActive() && request.auth.uid == clientUid);
      // Only platform admin can upload/modify/delete
      allow write: if isPlatformAdmin();
    }

    match /production/{projectId}/deliverables/{deliverableId}/{allPaths=**} {
      allow read: if isPlatformAdmin() || ownsPublishedDeliverable(projectId, deliverableId);
      allow create, update: if isPlatformAdmin() &&
        request.resource.size < 50 * 1024 * 1024 &&
        isValidCreativeAsset();
      allow delete: if isPlatformAdmin();
    }

    // Phase 6 Creative Products Storage Rules
    match /products/{productId}/internal/{allPaths=**} {
      allow read, write: if isPlatformAdmin() && isValidId(productId);
    }

    match /products/{productId}/previews/{allPaths=**} {
      allow read: if isValidId(productId) && (isPlatformAdmin() || canClientViewProductPreview(productId));
      allow create, update: if isPlatformAdmin() &&
        isValidId(productId) &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('^image/(jpeg|png|webp|avif)$');
      allow delete: if isPlatformAdmin() && isValidId(productId);
    }

    match /products/{productId}/deliverables/{allPaths=**} {
      allow read: if isValidId(productId) && (isPlatformAdmin() || canClientDownloadProductDeliverable(productId));
      allow create, update: if isPlatformAdmin() &&
        isValidId(productId) &&
        request.resource.size < 50 * 1024 * 1024 &&
        isValidCreativeAsset();
      allow delete: if isPlatformAdmin() && isValidId(productId);
    }

    // Internal KeedoHub Brand Room & Marketing Kit Storage (Strictly Admin-Only)
    match /brand-room/{allPaths=**} {
      allow read: if isPlatformAdmin();
      allow create, update: if isPlatformAdmin() &&
        request.resource.size < 50 * 1024 * 1024 &&
        isValidCreativeAsset();
      allow delete: if isPlatformAdmin();
    }

    // Default Deny Everything Else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
