rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isWorkspaceAccountActive() {
      return isSignedIn() &&
        (!firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)) ||
          !firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.keys().hasAny(['status']) ||
          firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.status != 'Suspended');
    }

    function isWorkspaceOpen(workspaceId) {
      return workspaceId is string &&
        firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)) &&
        (!firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)).data.keys().hasAny(['status']) ||
          firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)).data.status in ['Active', 'Onboarding']);
    }

    function ownsProjectWorkspace(workspaceId) {
      return workspaceId is string &&
        isWorkspaceOpen(workspaceId) &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function ownsClientProject(projectId) {
      return isSignedIn() &&
        isWorkspaceAccountActive() &&
        firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)) &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)).data.clientUid == request.auth.uid &&
        (
          (firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)).data.keys().hasAny(['workspaceId']) &&
            ownsProjectWorkspace(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)).data.workspaceId)) ||
          (!firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)).data.keys().hasAny(['workspaceId']) &&
            firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)) &&
            firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId is string &&
            ownsProjectWorkspace(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProfiles/$(request.auth.uid)).data.workspaceId))
        );
    }

    // Fail-Safe Workspace Ownership Check
    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() && 
        firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)) &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid &&
        isWorkspaceAccountActive() &&
        isWorkspaceOpen(workspaceId);
    }

    // Fail-Safe Cross-Service Workspace Membership Check (Enforcing Active Status)
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && (
        (
          firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)/memberships/$(request.auth.uid)) &&
          firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/workspaces/$(workspaceId)/memberships/$(request.auth.uid)).data.status == 'Active' &&
          isWorkspaceAccountActive() &&
          isWorkspaceOpen(workspaceId)
        ) ||
        isWorkspaceOwner(workspaceId) ||
        isPlatformAdmin()
      );
    }

    function isAdminRecordActive(adminData) {
      return (!adminData.keys().hasAny(['status']) ||
          !(adminData.status is string) ||
          !(adminData.status.trim().lower() in ['suspended', 'revoked', 'inactive', 'disabled'])) &&
        (!adminData.keys().hasAny(['revoked']) || adminData.revoked != true) &&
        (!adminData.keys().hasAny(['suspended']) || adminData.suspended != true) &&
        (!adminData.keys().hasAny(['active']) || adminData.active != false);
    }

    function isPlatformAdmin() {
      return isSignedIn() &&
        isWorkspaceAccountActive() &&
        firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/admins/$(request.auth.uid)) &&
        isAdminRecordActive(firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/admins/$(request.auth.uid)).data);
    }

    function ownsPublishedDeliverable(projectId, deliverableId) {
      return ownsClientProject(projectId) &&
        firestore.exists(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)/deliverables/$(deliverableId)) &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)/deliverables/$(deliverableId)).data.clientUid == request.auth.uid &&
        firestore.get(/databases/ai-studio-lyricalentbrandl-85ee0d5d-6fc2-41f3-a410-3e059e509c38/documents/clientProjects/$(projectId)/deliverables/$(deliverableId)).data.isClientPublished == true;
    }

    // Explicit Creative Asset MIME Allowlist
    function isValidCreativeAsset() {
      return request.resource.contentType.matches(
        '^(image/(jpeg|png|svg\\+xml|webp|gif|avif)|audio/(mpeg|wav|x-wav|aac|flac|mp4|m4a|ogg)|video/(mp4|webm|quicktime)|application/(pdf|json|xml|zip|x-zip-compressed|font-woff)|font/(ttf|otf|woff|woff2)|text/(plain|xml))$'
      );
    }

    // Operator Internal Notes & Confidential Staging (Restricted to Platform Admins)
    match /workspaces/{workspaceId}/internal/{allPaths=**} {
      allow read, write: if isPlatformAdmin();
    }

    // Workspace Private Files Path (Multi-Tenant Authorization, Volumetric & Content-Type Guards)
    match /workspaces/{workspaceId}/{allPaths=**} {
      allow read: if isWorkspaceMember(workspaceId);
      
      allow create, update: if isWorkspaceMember(workspaceId) && 
        request.resource.size < 50 * 1024 * 1024 && // Enforce 50MB maximum asset size limit
        isValidCreativeAsset();                     // Strict MIME allowlist validation
        
      allow delete: if isWorkspaceMember(workspaceId);
    }

    // Legacy client deliverables remain private to their owner and platform admins.
    match /clients/{clientUid}/deliverables/{deliverableId}/{fileName} {
      // Only the active owner client or platform admin can read
      allow read: if isPlatformAdmin() || (isWorkspaceAccountActive() && request.auth.uid == clientUid);
      // Only platform admin can upload/modify/delete
      allow write: if isPlatformAdmin();
    }

    match /production/{projectId}/deliverables/{deliverableId}/{allPaths=**} {
      allow read: if isPlatformAdmin() || ownsPublishedDeliverable(projectId, deliverableId);
      allow create, update: if isPlatformAdmin() &&
        request.resource.size < 50 * 1024 * 1024 &&
        isValidCreativeAsset();
      allow delete: if isPlatformAdmin();
    }

    // Default Deny Everything Else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
