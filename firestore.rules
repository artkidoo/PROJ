rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isWorkspaceAccountActive() {
      return isSignedIn() &&
        (!exists(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)) ||
          !get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.keys().hasAny(['status']) ||
          get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.status != 'Suspended');
    }

    function isWorkspaceOpen(workspaceId) {
      return workspaceId is string &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        (!get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.keys().hasAny(['status']) ||
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.status in ['Active', 'Onboarding']);
    }

    function ownsProjectWorkspace(workspaceId) {
      return workspaceId is string &&
        isWorkspaceOpen(workspaceId) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function ownsWorkspaceAfter(workspaceId) {
      return isSignedIn() &&
        existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Platform Level Admin check (verified against database document)
    function isPlatformAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Verified Workspace Ownership (Fail-safe existence check)
    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid &&
          isWorkspaceAccountActive() &&
          isWorkspaceOpen(workspaceId)
        ) ||
        isPlatformAdmin()
      );
    }

    // Verified Workspace Membership (Strict Active Status Validation)
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)/memberships/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/workspaces/$(workspaceId)/memberships/$(request.auth.uid)).data.status == 'Active' &&
          isWorkspaceAccountActive() &&
          isWorkspaceOpen(workspaceId)
        ) ||
        isWorkspaceOwner(workspaceId)
      );
    }

    function isProjectAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function ownsProject(projectId) {
      return isSignedIn() &&
        isWorkspaceAccountActive() &&
        exists(/databases/$(database)/documents/clientProjects/$(projectId)) &&
        get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientUid == request.auth.uid &&
        (!get(/databases/$(database)/documents/clientProjects/$(projectId)).data.keys().hasAny(['workspaceId']) ||
          ownsProjectWorkspace(get(/databases/$(database)/documents/clientProjects/$(projectId)).data.workspaceId));
    }

    function validProjectAssignment(data) {
      return data.clientUid is string &&
        exists(/databases/$(database)/documents/clientProfiles/$(data.clientUid));
    }

    function validProjectDocument(projectId, data) {
      return data.keys().hasOnly([
          'id', 'clientUid', 'title', 'description', 'category', 'status',
          'progress', 'startDate', 'expectedDeliveryDate', 'createdAt',
          'updatedAt', 'stage', 'priority', 'deliveredAt', 'workspaceId'
        ]) &&
        data.id == projectId &&
        validProjectAssignment(data) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
        data.description is string && data.description.size() <= 5000 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 160 &&
        data.status in ['Pending', 'Confirmed', 'In Progress', 'Review', 'Completed', 'On Hold'] &&
        data.progress is number && data.progress >= 0 && data.progress <= 100 &&
        data.startDate is string &&
        data.expectedDeliveryDate is string &&
        data.createdAt is string &&
        data.updatedAt is string &&
        (!data.keys().hasAny(['workspaceId']) ||
          (data.workspaceId is string &&
            exists(/databases/$(database)/documents/workspaces/$(data.workspaceId)) &&
            get(/databases/$(database)/documents/workspaces/$(data.workspaceId)).data.ownerId == data.clientUid &&
            get(/databases/$(database)/documents/workspaces/$(data.workspaceId)).data.status in ['Active', 'Onboarding'])) &&
        (!data.keys().hasAny(['stage']) ||
          data.stage in [
            'New Request', 'Brief Approved', 'In Production', 'Internal QA',
            'Client Review', 'Revision Required', 'Ready for Delivery', 'Delivered'
          ]) &&
        (!data.keys().hasAny(['priority']) ||
          data.priority in ['Low', 'Medium', 'Normal', 'High', 'Urgent']) &&
        (!data.keys().hasAny(['deliveredAt']) || data.deliveredAt is string);
    }

    function validProductionTask(projectId, taskId, data) {
      return data.keys().hasOnly([
          'id', 'projectId', 'clientUid', 'title', 'description', 'status',
          'dueDate', 'clientVisible', 'subtasks', 'createdAt', 'updatedAt'
        ]) &&
        data.id == taskId &&
        data.projectId == projectId &&
        data.clientUid ==
          get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientUid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.status in ['Todo', 'In Progress', 'In Review', 'Done'] &&
        data.clientVisible is bool &&
        (!data.keys().hasAny(['description']) ||
          (data.description is string && data.description.size() <= 5000)) &&
        (!data.keys().hasAny(['dueDate']) || data.dueDate is string) &&
        (!data.keys().hasAny(['subtasks']) ||
          (data.subtasks is list && data.subtasks.size() <= 100)) &&
        (!data.keys().hasAny(['createdAt']) || data.createdAt is string) &&
        (!data.keys().hasAny(['updatedAt']) || data.updatedAt is string);
    }

    function validProductionDeliverable(projectId, deliverableId, data) {
      return data.keys().hasOnly([
          'id', 'projectId', 'clientUid', 'title', 'description', 'fileUrl',
          'storagePath', 'fileName', 'fileType', 'fileSize', 'isClientPublished',
          'reviewStatus', 'feedback', 'approvedAt', 'approvedBy', 'createdAt',
          'rejectedAt', 'rejectedBy', 'updatedAt', 'uploadedBy',
          'legacyVersionNumber', 'currentVersion', 'versions'
        ]) &&
        data.id == deliverableId &&
        data.projectId == projectId &&
        data.clientUid ==
          get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientUid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.isClientPublished is bool &&
        data.reviewStatus in [
          'Draft', 'Awaiting Review', 'Approved', 'Rejected', 'Revision Requested',
          'Revision In Progress', 'Revised - Awaiting Review'
        ] &&
        (!data.keys().hasAny(['description']) ||
          (data.description is string && data.description.size() <= 5000)) &&
        (!data.keys().hasAny(['fileUrl']) || data.fileUrl is string) &&
        (!data.keys().hasAny(['storagePath']) ||
          data.storagePath == '' ||
          (data.storagePath is string &&
            data.storagePath.matches('^production/' + projectId + '/deliverables/' + deliverableId + '/([^/]+|v[1-9][0-9]*/[^/]+)$'))) &&
        (!data.keys().hasAny(['fileName']) || data.fileName is string) &&
        (!data.keys().hasAny(['fileType']) || data.fileType is string) &&
        (!data.keys().hasAny(['fileSize']) ||
          (data.fileSize is number && data.fileSize >= 0 && data.fileSize < 52428800)) &&
        (!data.keys().hasAny(['feedback']) ||
          (data.feedback is string && data.feedback.size() <= 5000)) &&
        (!data.keys().hasAny(['approvedAt']) || data.approvedAt is string) &&
        (!data.keys().hasAny(['approvedBy']) || data.approvedBy is string) &&
        (!data.keys().hasAny(['rejectedAt']) || data.rejectedAt is string) &&
        (!data.keys().hasAny(['rejectedBy']) || data.rejectedBy is string) &&
        (!data.keys().hasAny(['createdAt']) || data.createdAt is string) &&
        (!data.keys().hasAny(['updatedAt']) || data.updatedAt is string) &&
        (!data.keys().hasAny(['uploadedBy']) || data.uploadedBy is string) &&
        (!data.keys().hasAny(['legacyVersionNumber']) || data.legacyVersionNumber is string) &&
        (!data.keys().hasAny(['currentVersion']) ||
          (data.currentVersion is number && data.currentVersion >= 1)) &&
        (!data.keys().hasAny(['versions']) ||
          (data.versions is list && data.versions.size() <= 100));
    }

    function validProductionRevision(projectId, revisionId, data) {
      return data.keys().hasOnly([
          'id', 'projectId', 'deliverableId', 'clientUid', 'feedback', 'status',
          'submittedAt', 'completedAt', 'adminResponse', 'createdAt', 'updatedAt'
        ]) &&
        data.id == revisionId &&
        data.projectId == projectId &&
        data.clientUid ==
          get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientUid &&
        data.deliverableId is string &&
        exists(/databases/$(database)/documents/clientProjects/$(projectId)/deliverables/$(data.deliverableId)) &&
        get(/databases/$(database)/documents/clientProjects/$(projectId)/deliverables/$(data.deliverableId)).data.clientUid ==
          data.clientUid &&
        data.feedback is string && data.feedback.size() > 0 && data.feedback.size() <= 5000 &&
        data.status in ['Submitted', 'In Progress', 'Completed', 'Cancelled'] &&
        data.submittedAt is string &&
        data.createdAt is string &&
        data.updatedAt is string &&
        (!data.keys().hasAny(['completedAt']) || data.completedAt is string) &&
        (!data.keys().hasAny(['adminResponse']) ||
          (data.adminResponse is string && data.adminResponse.size() <= 5000));
    }


    // Administrative Audit Logs (Trusted Backend Writes Only)
    match /adminAuditLogs/{logId} {
      allow read: if isPlatformAdmin();
      allow write: if false; // Writes via trusted Cloud Functions only
    }
    // Default Deny Everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Platform Admin Roles Collection (System Protected)
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // Only server/console can assign platform admin
    }

    // Platform User Profiles (Privacy Protected)
    match /users/{userId} {
      // Private profiles readable only by account owner or verified platform admin
      allow read: if isOwner(userId) || isPlatformAdmin();

      // Prevent users from self-assigning privileged roles or admin status upon creation
      // Allowlist of permitted fields for client-created profiles
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        (!request.resource.data.keys().hasAny(['role', 'isAdmin', 'isPlatformAdmin'])) &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'accountType', 'organizationName', 'onboardingComplete', 'createdAt', 'updatedAt']);

      // Prevent users from modifying their own privileged roles, admin status, or immutable identity fields
      allow update: if isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'isPlatformAdmin', 'uid', 'email', 'createdAt'])) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'accountType', 'organizationName', 'onboardingComplete', 'updatedAt']);

      allow delete: if isPlatformAdmin();
    }

    // Workspaces Container
    match /workspaces/{workspaceId} {
      // Users can only read workspace metadata if they are an owner or active member
      allow read: if isWorkspaceMember(workspaceId) ||
        isWorkspaceOwner(workspaceId) ||
        (isWorkspaceAccountActive() && resource.data.ownerId == request.auth.uid);

      // Users can create a workspace setting themselves as owner
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        isValidId(workspaceId) &&
        isWorkspaceAccountActive() &&
        (isPlatformAdmin() ||
          (exists(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.onboardingComplete == true));

      // Only workspace owner or platform admin can update or delete workspace settings
      allow update: if isPlatformAdmin() ||
        (isWorkspaceOwner(workspaceId) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'contactEmail', 'brand', 'artistProfile',
            'brandProfile', 'updatedAt'
          ]));
      allow delete: if isPlatformAdmin();

      // Memberships Subcollection (Strict RBAC & Status Controls)
      match /memberships/{membershipId} {
        // Active members can view workspace team roster
        allow read: if isWorkspaceMember(workspaceId);
        // Only workspace owner or admin can invite/modify memberships; users cannot self-assign
        allow create, update, delete: if isWorkspaceOwner(workspaceId);
      }

      // Workspace Owned Subcollections (Active Membership Required)
      match /artists/{artistId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /releases/{releaseId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /campaigns/{campaignId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /contentItems/{contentId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /documents/{documentId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /brandAssets/{assetId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /tasks/{taskId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /pressReleases/{pressId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /mediaContacts/{contactId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /campaignDesigns/{designId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /services/{serviceId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow write: if isWorkspaceOwner(workspaceId);
      }
    }

    // Client Profiles (Phase 2A - Onboarding)
    match /clientProfiles/{profileId} {
      allow read: if isOwner(profileId) || isPlatformAdmin();
      allow create: if isOwner(profileId) &&
        request.resource.data.uid == profileId &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.displayName.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.accountType in ['Artist', 'Brand', 'Company'] &&
        request.resource.data.organizationName is string &&
        request.resource.data.organizationName.size() > 0 &&
        request.resource.data.organizationName.size() <= 100 &&
        request.resource.data.onboardingComplete == true &&
        (!request.resource.data.keys().hasAny(['workspaceId']) ||
          (request.resource.data.workspaceId is string && ownsWorkspaceAfter(request.resource.data.workspaceId))) &&
        (!request.resource.data.keys().hasAny(['role', 'isAdmin', 'isPlatformAdmin']));
      allow update: if isOwner(profileId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'accountType', 'organizationName', 'photoURL', 'onboardingComplete', 'workspaceId', 'updatedAt']) &&
        request.resource.data.onboardingComplete == true &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['workspaceId']) ||
          (request.resource.data.workspaceId is string && ownsWorkspaceAfter(request.resource.data.workspaceId))) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.displayName.size() <= 100 &&
        request.resource.data.accountType in ['Artist', 'Brand', 'Company'] &&
        request.resource.data.organizationName is string &&
        request.resource.data.organizationName.size() > 0 &&
        request.resource.data.organizationName.size() <= 100 &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'isPlatformAdmin']));
      allow delete: if isPlatformAdmin();
    }

    // Client Projects and production records (Phase 3C)
    match /clientProjects/{projectId} {
      allow get, list: if isProjectAdmin() || ownsProject(projectId);
      allow create: if isProjectAdmin() &&
        validProjectDocument(projectId, request.resource.data);
      allow update: if isProjectAdmin() &&
        validProjectDocument(projectId, request.resource.data);
      allow delete: if false;

      match /admin/{privateDocId} {
        allow read: if isProjectAdmin();
        allow create, update: if isProjectAdmin() &&
          (!request.resource.data.keys().hasAny(['assignedToUid']) ||
            request.resource.data.assignedToUid == '' ||
            exists(/databases/$(database)/documents/users/$(request.resource.data.assignedToUid)));
        allow delete: if false;
      }

      match /tasks/{taskId} {
        allow read: if isProjectAdmin() ||
          (ownsProject(projectId) &&
            resource.data.projectId == projectId &&
            resource.data.clientUid == request.auth.uid &&
            resource.data.clientVisible == true);
        allow create, update: if isProjectAdmin() &&
          validProductionTask(projectId, taskId, request.resource.data);
        allow delete: if false;

        match /admin/{privateDocId} {
          allow read: if isProjectAdmin();
          allow create, update: if isProjectAdmin() &&
            exists(/databases/$(database)/documents/clientProjects/$(projectId)/tasks/$(taskId)) &&
            (!request.resource.data.keys().hasAny(['assigneeUid']) ||
              request.resource.data.assigneeUid == '' ||
              exists(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)));
          allow delete: if false;
        }
      }

      match /deliverables/{deliverableId} {
        allow read: if isProjectAdmin() ||
          (ownsProject(projectId) &&
            resource.data.projectId == projectId &&
            resource.data.clientUid == request.auth.uid &&
            resource.data.isClientPublished == true);
        allow create, update: if isProjectAdmin() &&
          validProductionDeliverable(projectId, deliverableId, request.resource.data);
        allow delete: if false;
      }

      match /revisionRequests/{revisionId} {
        allow get, list: if isProjectAdmin() ||
          (ownsProject(projectId) &&
            resource.data.projectId == projectId &&
            resource.data.clientUid == request.auth.uid);
        allow create: if isProjectAdmin() &&
          validProductionRevision(projectId, revisionId, request.resource.data);
        allow update: if isProjectAdmin() &&
          request.resource.data.projectId == resource.data.projectId &&
          request.resource.data.clientUid == resource.data.clientUid &&
          request.resource.data.deliverableId == resource.data.deliverableId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'adminResponse', 'updatedAt']) &&
          request.resource.data.status in ['Submitted', 'In Progress', 'Completed', 'Cancelled'];
        allow delete: if false;
      }

      match /internalNotes/{noteId} {
        allow read, write: if isProjectAdmin();
      }

      match /activity/{activityId} {
        allow read: if isProjectAdmin() ||
          (ownsProject(projectId) &&
            resource.data.projectId == projectId &&
            resource.data.clientVisible == true);
        allow create: if isProjectAdmin() &&
          request.resource.data.projectId == projectId &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.keys().hasOnly([
            'id', 'projectId', 'actorUid', 'actorName', 'action', 'details',
            'clientVisible', 'createdAt'
          ]) &&
          request.resource.data.actorName is string &&
          request.resource.data.action is string &&
          request.resource.data.details is string &&
          request.resource.data.details.size() <= 5000 &&
          request.resource.data.clientVisible is bool &&
          request.resource.data.createdAt is string;
        allow update, delete: if false;
      }
    }

    // Collection-group reads power the admin review queue across client projects.
    // Keep these queries admin-only; direct per-project client reads remain governed above.
    match /{parentPath=**}/deliverables/{deliverableId} {
      allow get, list: if isProjectAdmin();
    }

    match /{parentPath=**}/revisionRequests/{revisionId} {
      allow get, list: if isProjectAdmin();
    }

    match /productionTasks/{taskId} {
      allow get, list: if isProjectAdmin();
      allow create, update: if isProjectAdmin() &&
        (!request.resource.data.keys().hasAny(['projectId']) ||
          (request.resource.data.projectId is string &&
            exists(/databases/$(database)/documents/clientProjects/$(request.resource.data.projectId)) &&
            request.resource.data.clientUid ==
              get(/databases/$(database)/documents/clientProjects/$(request.resource.data.projectId)).data.clientUid)) &&
        request.resource.data.title is string &&
        request.resource.data.status in ['Todo', 'In Progress', 'In Review', 'Done'] &&
        request.resource.data.clientVisible is bool;
      allow delete: if false;

      match /admin/{privateDocId} {
        allow read: if isProjectAdmin();
        allow create, update: if isProjectAdmin() &&
          (!request.resource.data.keys().hasAny(['assigneeUid']) ||
            request.resource.data.assigneeUid == '' ||
            exists(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)));
        allow delete: if false;
      }
    }

    // Client Deliverables (Phase 2A + 2C + 2C.2)
    // Clients can only update feedback. Review status, approval, and version changes are handled by trusted backend (Cloud Functions) or admin.
    match /clientDeliverables/{deliverableId} {
      allow read: if isSignedIn() && (resource.data.clientUid is string && (resource.data.clientUid == request.auth.uid || isPlatformAdmin()));
      allow create: if isPlatformAdmin();
      allow update: if isPlatformAdmin() || (isSignedIn() && resource.data.clientUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback']));
      allow delete: if isPlatformAdmin();
    }

    // Revision Requests (Phase 2C + 2C.2)
    // Clients CANNOT create, update, or delete revision requests directly.
    // All creation is handled by trusted Cloud Functions (requestRevision).
    // All updates are handled by authorized admins or trusted backend.
    match /revisionRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.clientUid is string && (resource.data.clientUid == request.auth.uid || isPlatformAdmin()));
      allow create: if false; // Only Cloud Functions (Admin SDK) can create
      allow update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // Client Notifications (Phase 2A)
    match /clientNotifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.clientUid is string && (resource.data.clientUid == request.auth.uid || isPlatformAdmin()));
      allow create: if isPlatformAdmin();
      allow update: if isSignedIn() && resource.data.clientUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
      allow delete: if isPlatformAdmin();
    }

    match /userNotifications/{uid}/items/{notificationId} {
      allow get, list: if isOwner(uid);
      allow create, delete: if false;
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']) &&
        request.resource.data.read is bool &&
        request.resource.data.updatedAt is string;
    }

    // Global Service Packages Catalog (Read: Authenticated Users, Write: Platform Admin)
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }
  }
}
