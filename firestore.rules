rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isWorkspaceAccountActive() {
      return isSignedIn() &&
        (!exists(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)) ||
          !get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.keys().hasAny(['status', 'Status']) ||
          ((!get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.keys().hasAny(['status']) ||
            !(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.status is string) ||
            !(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.status.trim().lower() in ['suspended', 'revoked', 'disabled'])) &&
           (!get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.keys().hasAny(['Status']) ||
            !(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.Status is string) ||
            !(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.Status.trim().lower() in ['suspended', 'revoked', 'disabled']))));
    }

    function isWorkspaceOpen(workspaceId) {
      return workspaceId is string &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        (!get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.keys().hasAny(['status']) ||
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.status in ['Active', 'Onboarding']);
    }

    function ownsProjectWorkspace(workspaceId) {
      return workspaceId is string &&
        isWorkspaceOpen(workspaceId) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function ownsWorkspaceAfter(workspaceId) {
      return isSignedIn() &&
        existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasPlatformAdminRole(adminData) {
      return (adminData.keys().hasAny(['role']) &&
        adminData.role is string &&
        adminData.role.trim().lower() in ['platformadmin', 'platform admin', 'superadmin', 'super admin']) ||
        (adminData.keys().hasAny(['Role']) &&
        adminData.Role is string &&
        adminData.Role.trim().lower() in ['platformadmin', 'platform admin', 'superadmin', 'super admin']);
    }

    function isAdminRecordActive(adminData) {
      return hasPlatformAdminRole(adminData) &&
        (!adminData.keys().hasAny(['status']) ||
          !(adminData.status is string) ||
          !(adminData.status.trim().lower() in ['suspended', 'revoked', 'inactive', 'disabled'])) &&
        (!adminData.keys().hasAny(['Status']) ||
          !(adminData.Status is string) ||
          !(adminData.Status.trim().lower() in ['suspended', 'revoked', 'inactive', 'disabled'])) &&
        (!adminData.keys().hasAny(['revoked']) || adminData.revoked != true) &&
        (!adminData.keys().hasAny(['suspended']) || adminData.suspended != true) &&
        (!adminData.keys().hasAny(['active']) || adminData.active != false) &&
        (!adminData.keys().hasAny(['Active']) || adminData.Active != false);
    }

    // Platform Level Admin check (verified against active database document & non-suspended account)
    function isPlatformAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        isAdminRecordActive(get(/databases/$(database)/documents/admins/$(request.auth.uid)).data) &&
        isWorkspaceAccountActive();
    }

    // Verified Workspace Ownership (Fail-safe existence check)
    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() && (
        isPlatformAdmin() ||
        (
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid &&
          isWorkspaceAccountActive() &&
          isWorkspaceOpen(workspaceId)
        )
      );
    }

    // Verified Workspace Membership (Strict Active Status Validation)
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && (
        isPlatformAdmin() ||
        (
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)/memberships/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/workspaces/$(workspaceId)/memberships/$(request.auth.uid)).data.status == 'Active' &&
          isWorkspaceAccountActive() &&
          isWorkspaceOpen(workspaceId)
        ) ||
        isWorkspaceOwner(workspaceId)
      );
    }

    function isInternalAssetStoragePath(path) {
      return path is string &&
        (path.matches('^workspaces/[^/]+/internal(/.*)?$') ||
         path.matches('^internal(/.*)?$'));
    }

    function isLegacyInternalBrandAsset(data) {
      return (data.keys().hasAny(['storagePath']) &&
          isInternalAssetStoragePath(data.storagePath)) ||
        (data.keys().hasAny(['isInternal']) && data.isInternal == true);
    }

    function isProjectAdmin() {
      return isPlatformAdmin();
    }

    function ownsProject(projectId) {
      return isSignedIn() &&
        isWorkspaceAccountActive() &&
        exists(/databases/$(database)/documents/clientProjects/$(projectId)) &&
        get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientUid == request.auth.uid &&
        (
          (get(/databases/$(database)/documents/clientProjects/$(projectId)).data.keys().hasAny(['workspaceId']) &&
            ownsProjectWorkspace(get(/databases/$(database)/documents/clientProjects/$(projectId)).data.workspaceId)) ||
          (!get(/databases/$(database)/documents/clientProjects/$(projectId)).data.keys().hasAny(['workspaceId']) &&
            exists(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId is string &&
            ownsProjectWorkspace(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId))
        );
    }

    function validProjectAssignment(data) {
      return data.clientUid is string &&
        exists(/databases/$(database)/documents/clientProfiles/$(data.clientUid));
    }

    function validProjectDocument(projectId, data, requireOpenWorkspace) {
      return data.keys().hasOnly([
          'id', 'clientUid', 'title', 'description', 'category', 'status',
          'progress', 'startDate', 'expectedDeliveryDate', 'createdAt',
          'updatedAt', 'stage', 'priority', 'deliveredAt', 'workspaceId',
          'requestStatus', 'adminMessage', 'requestHistory', 'requestAttachments',
          'requestAttachmentsOwnerUid', 'requestAttachmentsWorkspaceId'
        ]) &&
        data.id == projectId &&
        validProjectAssignment(data) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
        data.description is string && data.description.size() <= 5000 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 160 &&
        data.status in ['Pending', 'Confirmed', 'In Progress', 'Review', 'Completed', 'On Hold'] &&
        data.progress is number && data.progress >= 0 && data.progress <= 100 &&
        data.startDate is string &&
        data.expectedDeliveryDate is string &&
        data.createdAt is string &&
        data.updatedAt is string &&
        (!data.keys().hasAny(['workspaceId']) ||
          (data.workspaceId is string &&
            exists(/databases/$(database)/documents/workspaces/$(data.workspaceId)) &&
            get(/databases/$(database)/documents/workspaces/$(data.workspaceId)).data.ownerId == data.clientUid &&
            (!requireOpenWorkspace ||
              !get(/databases/$(database)/documents/workspaces/$(data.workspaceId)).data.keys().hasAny(['status']) ||
              get(/databases/$(database)/documents/workspaces/$(data.workspaceId)).data.status in ['Active', 'Onboarding']))) &&
        (!data.keys().hasAny(['stage']) ||
          data.stage in [
            'New Request', 'Brief Approved', 'In Production', 'Internal QA',
            'Client Review', 'Revision Required', 'Ready for Delivery', 'Delivered'
          ]) &&
        (!data.keys().hasAny(['priority']) ||
          data.priority in ['Low', 'Medium', 'Normal', 'High', 'Urgent']) &&
        (!data.keys().hasAny(['deliveredAt']) || data.deliveredAt is string) &&
        (!data.keys().hasAny(['requestStatus']) ||
          data.requestStatus in ['Pending', 'Clarification Requested', 'Accepted', 'Rejected']) &&
        (!data.keys().hasAny(['adminMessage']) ||
          (data.adminMessage is string && data.adminMessage.size() <= 5000)) &&
        (!data.keys().hasAny(['requestHistory']) ||
          (data.requestHistory is list && data.requestHistory.size() <= 100)) &&
        (!data.keys().hasAny(['requestAttachments']) ||
          (data.requestAttachments is list && data.requestAttachments.size() <= 5)) &&
        (!data.keys().hasAny(['requestAttachmentsOwnerUid']) ||
          data.requestAttachmentsOwnerUid == data.clientUid) &&
        (!data.keys().hasAny(['requestAttachmentsWorkspaceId']) ||
          data.requestAttachmentsWorkspaceId == data.workspaceId);
    }

    function validProductionTask(projectId, taskId, data) {
      return data.keys().hasOnly([
          'id', 'projectId', 'clientUid', 'title', 'description', 'status',
          'dueDate', 'clientVisible', 'subtasks', 'createdAt', 'updatedAt'
        ]) &&
        data.id == taskId &&
        data.projectId == projectId &&
        data.clientUid ==
          get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientUid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.status in ['Todo', 'In Progress', 'In Review', 'Done'] &&
        data.clientVisible is bool &&
        (!data.keys().hasAny(['description']) ||
          (data.description is string && data.description.size() <= 5000)) &&
        (!data.keys().hasAny(['dueDate']) || data.dueDate is string) &&
        (!data.keys().hasAny(['subtasks']) ||
          (data.subtasks is list && data.subtasks.size() <= 100)) &&
        (!data.keys().hasAny(['createdAt']) || data.createdAt is string) &&
        (!data.keys().hasAny(['updatedAt']) || data.updatedAt is string);
    }

    function validProductionDeliverable(projectId, deliverableId, data) {
      return data.keys().hasOnly([
          'id', 'projectId', 'clientUid', 'title', 'description', 'fileUrl',
          'storagePath', 'fileName', 'fileType', 'fileSize', 'isClientPublished',
          'reviewStatus', 'feedback', 'approvedAt', 'approvedBy', 'createdAt',
          'rejectedAt', 'rejectedBy', 'updatedAt', 'uploadedBy',
          'legacyVersionNumber', 'currentVersion', 'versions'
        ]) &&
        data.id == deliverableId &&
        data.projectId == projectId &&
        data.clientUid ==
          get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientUid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.isClientPublished is bool &&
        data.reviewStatus in [
          'Draft', 'Awaiting Review', 'Approved', 'Rejected', 'Revision Requested',
          'Revision In Progress', 'Revised - Awaiting Review'
        ] &&
        (!data.keys().hasAny(['description']) ||
          (data.description is string && data.description.size() <= 5000)) &&
        (!data.keys().hasAny(['fileUrl']) || data.fileUrl is string) &&
        (!data.keys().hasAny(['storagePath']) ||
          data.storagePath == '' ||
          (data.storagePath is string &&
            data.storagePath.matches('^production/' + projectId + '/deliverables/' + deliverableId + '/([^/]+|v[1-9][0-9]*/[^/]+)$'))) &&
        (!data.keys().hasAny(['fileName']) || data.fileName is string) &&
        (!data.keys().hasAny(['fileType']) || data.fileType is string) &&
        (!data.keys().hasAny(['fileSize']) ||
          (data.fileSize is number && data.fileSize >= 0 && data.fileSize < 52428800)) &&
        (!data.keys().hasAny(['feedback']) ||
          (data.feedback is string && data.feedback.size() <= 5000)) &&
        (!data.keys().hasAny(['approvedAt']) || data.approvedAt is string) &&
        (!data.keys().hasAny(['approvedBy']) || data.approvedBy is string) &&
        (!data.keys().hasAny(['rejectedAt']) || data.rejectedAt is string) &&
        (!data.keys().hasAny(['rejectedBy']) || data.rejectedBy is string) &&
        (!data.keys().hasAny(['createdAt']) || data.createdAt is string) &&
        (!data.keys().hasAny(['updatedAt']) || data.updatedAt is string) &&
        (!data.keys().hasAny(['uploadedBy']) || data.uploadedBy is string) &&
        (!data.keys().hasAny(['legacyVersionNumber']) || data.legacyVersionNumber is string) &&
        (!data.keys().hasAny(['currentVersion']) ||
          (data.currentVersion is number && data.currentVersion >= 1)) &&
        (!data.keys().hasAny(['versions']) ||
          (data.versions is list && data.versions.size() <= 100));
    }

    function validProductionRevision(projectId, revisionId, data) {
      return data.keys().hasOnly([
          'id', 'projectId', 'deliverableId', 'clientUid', 'feedback', 'status',
          'submittedAt', 'completedAt', 'adminResponse', 'createdAt', 'updatedAt'
        ]) &&
        data.id == revisionId &&
        data.projectId == projectId &&
        data.clientUid ==
          get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientUid &&
        data.deliverableId is string &&
        exists(/databases/$(database)/documents/clientProjects/$(projectId)/deliverables/$(data.deliverableId)) &&
        get(/databases/$(database)/documents/clientProjects/$(projectId)/deliverables/$(data.deliverableId)).data.clientUid ==
          data.clientUid &&
        data.feedback is string && data.feedback.size() > 0 && data.feedback.size() <= 5000 &&
        data.status in ['Submitted', 'In Progress', 'Completed', 'Cancelled'] &&
        data.submittedAt is string &&
        data.createdAt is string &&
        data.updatedAt is string &&
        (!data.keys().hasAny(['completedAt']) || data.completedAt is string) &&
        (!data.keys().hasAny(['adminResponse']) ||
          (data.adminResponse is string && data.adminResponse.size() <= 5000));
    }


    // Administrative Audit Logs (Trusted Backend Writes Only)
    match /adminAuditLogs/{logId} {
      allow read: if isPlatformAdmin();
      allow write: if false; // Writes via trusted Cloud Functions only
    }

    match /serviceEnquiries/{enquiryId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // Platform Settings (Admin-Only Access)
    // All platform configuration writes MUST go through Cloud Functions
    // (assertActiveAdmin) to prevent privilege escalation.
    // Direct client-side writes — including writes by admins — are DENIED.
    match /settings/{documentId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }
    // Default Deny Everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Platform Admin Roles Collection (System Protected)
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isPlatformAdmin());
      allow list: if isPlatformAdmin();
      allow write: if false; // Only server/console can assign platform admin
    }

    // Platform User Profiles (Privacy Protected)
    match /users/{userId} {
      // Private profiles readable only by account owner or verified platform admin
      allow read: if isOwner(userId) || isPlatformAdmin();

      // Prevent users from self-assigning privileged roles or admin status upon creation
      // Allowlist of permitted fields for client-created profiles
      allow create: if isPlatformAdmin() || (
        isOwner(userId) &&
        request.resource.data.uid == userId &&
        (!request.resource.data.keys().hasAny(['role', 'isAdmin', 'isPlatformAdmin'])) &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'accountType', 'organizationName', 'onboardingComplete', 'createdAt', 'updatedAt']) &&
        (!request.resource.data.keys().hasAny(['accountType']) ||
          request.resource.data.accountType in ['Artist', 'Brand'])
      );

      // Prevent users from modifying their own privileged roles, admin status, or immutable identity fields,
      // and lock accountType after onboarding completes so clients cannot switch OS experiences themselves.
      allow update: if isPlatformAdmin() || (
        isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'isPlatformAdmin', 'uid', 'email', 'createdAt'])) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'accountType', 'organizationName', 'onboardingComplete', 'updatedAt']) &&
        (!(resource.data.keys().hasAny(['onboardingComplete']) && resource.data.onboardingComplete == true) ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType'])) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType']) ||
          request.resource.data.accountType in ['Artist', 'Brand'])
      );

      allow delete: if isPlatformAdmin();
    }

    // Workspaces Container
    match /workspaces/{workspaceId} {
      // Platform admins can read all workspaces; users can read if owner or active member
      allow read: if isPlatformAdmin() ||
        isWorkspaceMember(workspaceId) ||
        isWorkspaceOwner(workspaceId) ||
        (isWorkspaceAccountActive() &&
          resource.data.ownerId == request.auth.uid &&
          (!resource.data.keys().hasAny(['status']) ||
            resource.data.status in ['Active', 'Onboarding']));

      // Users can create a workspace setting themselves as owner (strict field allowlist & initial status check)
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        isValidId(workspaceId) &&
        isWorkspaceAccountActive() &&
        request.resource.data.keys().hasOnly([
          'id', 'name', 'type', 'clientCategory', 'ownerId', 'status',
          'description', 'contactEmail', 'brand', 'artistProfile',
          'brandProfile', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.id == workspaceId &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.type in ['Artist', 'Brand'] &&
        (!request.resource.data.keys().hasAny(['clientCategory']) ||
          request.resource.data.clientCategory in ['artist', 'brand']) &&
        request.resource.data.status in ['Active', 'Onboarding'] &&
        (!request.resource.data.keys().hasAny(['description']) ||
          (request.resource.data.description is string && request.resource.data.description.size() <= 1000)) &&
        (!request.resource.data.keys().hasAny(['contactEmail']) ||
          (request.resource.data.contactEmail is string && request.resource.data.contactEmail.size() <= 254)) &&
        (!request.resource.data.keys().hasAny(['brand']) || request.resource.data.brand is map) &&
        (!request.resource.data.keys().hasAny(['artistProfile']) || request.resource.data.artistProfile is map) &&
        (!request.resource.data.keys().hasAny(['brandProfile']) || request.resource.data.brandProfile is map) &&
        request.resource.data.createdAt is string &&
        request.resource.data.updatedAt is string &&
        (isPlatformAdmin() ||
          (exists(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.onboardingComplete == true));

      // Only workspace owner or platform admin can update or delete workspace settings
      allow update: if isPlatformAdmin() ||
        (isWorkspaceOwner(workspaceId) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'contactEmail', 'brand', 'artistProfile',
            'brandProfile', 'updatedAt'
          ]));
      allow delete: if isPlatformAdmin();

      // Memberships Subcollection (Strict RBAC & Status Controls)
      match /memberships/{membershipId} {
        // Active members can view workspace team roster
        allow read: if isWorkspaceMember(workspaceId);
        // Only workspace owner or admin can invite/modify memberships; users cannot self-assign
        allow create, update, delete: if isWorkspaceOwner(workspaceId);
      }

    function isCommercialDocumentType(docType) {
      return docType is string &&
        docType.trim().lower() in [
          'invoice',
          'receipt',
          'proposal',
          'quotation',
          'partnership_proposal',
          'sponsorship_proposal',
          'commercial_contract'
        ];
    }

    function hasCommercialFinanceFields(data) {
      return data.keys().hasAny([
        'totalAmount',
        'totalPaid',
        'balanceDue',
        'payments',
        'subtotal',
        'taxRate',
        'taxAmount',
        'discountAmount',
        'clientAction',
        'clientResponse',
        'issuedByAdmin',
        'issuedByUid'
      ]);
    }

    function isValidNonCommercialWorkspaceDocument(workspaceId, documentId, data) {
      return isValidId(documentId) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
        data.type is string && data.type.size() > 0 && data.type.size() <= 64 &&
        !isCommercialDocumentType(data.type) &&
        !hasCommercialFinanceFields(data) &&
        (!data.keys().hasAny(['workspaceId']) || data.workspaceId == workspaceId) &&
        (!data.keys().hasAny(['library']) || data.library in ['artist', 'brand']) &&
        (!data.keys().hasAny(['status']) ||
          data.status in ['Draft', 'Under Review', 'Approved', 'Issued', 'Archived', 'Cancelled']) &&
        (!data.keys().hasAny(['bodyContent']) ||
          (data.bodyContent is string && data.bodyContent.size() <= 20000));
    }

      // Workspace Owned Subcollections (Active Membership Required)
      match /artists/{artistId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /releases/{releaseId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /campaigns/{campaignId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /contentItems/{contentId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /documents/{documentId} {
        allow read: if isPlatformAdmin() || isWorkspaceMember(workspaceId);
        allow create: if isPlatformAdmin() ||
          (isWorkspaceMember(workspaceId) &&
            isValidNonCommercialWorkspaceDocument(workspaceId, documentId, request.resource.data));
        allow update: if isPlatformAdmin() ||
          (isWorkspaceMember(workspaceId) &&
            !isCommercialDocumentType(resource.data.type) &&
            (!resource.data.keys().hasAny(['issuedByAdmin']) || resource.data.issuedByAdmin != true) &&
            isValidNonCommercialWorkspaceDocument(workspaceId, documentId, request.resource.data));
        allow delete: if isPlatformAdmin() ||
          (isWorkspaceMember(workspaceId) &&
            !isCommercialDocumentType(resource.data.type) &&
            (!resource.data.keys().hasAny(['issuedByAdmin']) || resource.data.issuedByAdmin != true));
      }
      match /brandAssets/{assetId} {
        allow get: if isPlatformAdmin() ||
          (isWorkspaceMember(workspaceId) && !isLegacyInternalBrandAsset(resource.data));
        allow list: if isPlatformAdmin() ||
          (isWorkspaceMember(workspaceId) && resource.data.isInternal == false);
        allow create: if isPlatformAdmin() ||
          (isWorkspaceMember(workspaceId) &&
            !isLegacyInternalBrandAsset(request.resource.data) &&
            request.resource.data.isInternal == false);
        allow update: if isPlatformAdmin() ||
          (isWorkspaceMember(workspaceId) &&
            !isLegacyInternalBrandAsset(resource.data) &&
            !isLegacyInternalBrandAsset(request.resource.data) &&
            request.resource.data.isInternal == false);
        allow delete: if isPlatformAdmin() ||
          (isWorkspaceMember(workspaceId) && !isLegacyInternalBrandAsset(resource.data));
      }
      match /internalAssets/{assetId} { allow read, write: if isPlatformAdmin(); }
      match /tasks/{taskId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /pressReleases/{pressId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /mediaContacts/{contactId} { allow read, write: if isWorkspaceMember(workspaceId); }
      match /campaignDesigns/{designId} { allow read, write: if isPlatformAdmin(); }
      match /services/{serviceId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow write: if isWorkspaceOwner(workspaceId);
      }
    }

    // Client Profiles (Phase 2A - Onboarding & Admin Account Management)
    match /clientProfiles/{profileId} {
      allow get: if isOwner(profileId) || isPlatformAdmin();
      allow list: if isPlatformAdmin();
      allow create: if isOwner(profileId) &&
        request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'accountType',
          'organizationName', 'onboardingComplete', 'workspaceId',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.uid == profileId &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.displayName.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        (!request.resource.data.keys().hasAny(['photoURL']) ||
          (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048)) &&
        request.resource.data.accountType in ['Artist', 'Brand'] &&
        request.resource.data.organizationName is string &&
        request.resource.data.organizationName.size() > 0 &&
        request.resource.data.organizationName.size() <= 100 &&
        request.resource.data.onboardingComplete == true &&
        (!request.resource.data.keys().hasAny(['workspaceId']) ||
          (request.resource.data.workspaceId is string && ownsWorkspaceAfter(request.resource.data.workspaceId))) &&
        (!request.resource.data.keys().hasAny(['createdAt']) ||
          (request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 64)) &&
        (!request.resource.data.keys().hasAny(['updatedAt']) ||
          (request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 64));
      allow update: if (
        // Authenticated non-suspended client updating their own permitted onboarding/profile fields
        isOwner(profileId) &&
        isWorkspaceAccountActive() &&
        (!resource.data.keys().hasAny(['uid']) || request.resource.data.uid == resource.data.uid) &&
        (!request.resource.data.keys().hasAny(['uid']) || request.resource.data.uid == profileId) &&
        (!resource.data.keys().hasAny(['email']) || request.resource.data.email == resource.data.email) &&
        (!resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt == resource.data.createdAt) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isAdmin', 'isPlatformAdmin', 'status', 'suspended', 'revoked', 'active', 'uid', 'email', 'createdAt'
        ])) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'accountType', 'organizationName', 'photoURL',
          'onboardingComplete', 'workspaceId', 'updatedAt'
        ]) &&
        request.resource.data.onboardingComplete == true &&
        (!(resource.data.keys().hasAny(['onboardingComplete']) && resource.data.onboardingComplete == true) ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType'])) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['workspaceId']) ||
          (request.resource.data.workspaceId is string && ownsWorkspaceAfter(request.resource.data.workspaceId))) &&
        (!request.resource.data.keys().hasAny(['displayName']) ||
          (request.resource.data.displayName is string &&
            request.resource.data.displayName.size() > 0 &&
            request.resource.data.displayName.size() <= 100)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType']) ||
          request.resource.data.accountType in ['Artist', 'Brand']) &&
        (!request.resource.data.keys().hasAny(['organizationName']) ||
          (request.resource.data.organizationName is string &&
            request.resource.data.organizationName.size() > 0 &&
            request.resource.data.organizationName.size() <= 100)) &&
        (!request.resource.data.keys().hasAny(['photoURL']) ||
          (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048)) &&
        (!request.resource.data.keys().hasAny(['updatedAt']) ||
          (request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 64))
      ) || (
        // Authorized active PlatformAdmin performing legitimate administrative profile updates
        isPlatformAdmin() &&
        (!resource.data.keys().hasAny(['uid']) || request.resource.data.uid == resource.data.uid) &&
        (!resource.data.keys().hasAny(['email']) || request.resource.data.email == resource.data.email) &&
        (!resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt == resource.data.createdAt) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isAdmin', 'isPlatformAdmin', 'suspended', 'revoked', 'active', 'uid', 'email', 'createdAt'
        ])) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'accountType', 'organizationName', 'photoURL',
          'onboardingComplete', 'workspaceId', 'status', 'updatedAt'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']) ||
          (request.resource.data.displayName is string &&
            request.resource.data.displayName.size() > 0 &&
            request.resource.data.displayName.size() <= 100)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType']) ||
          request.resource.data.accountType in ['Artist', 'Brand']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizationName']) ||
          (request.resource.data.organizationName is string &&
            request.resource.data.organizationName.size() > 0 &&
            request.resource.data.organizationName.size() <= 100)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoURL']) ||
          (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['onboardingComplete']) ||
          request.resource.data.onboardingComplete is bool) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['workspaceId']) ||
          (request.resource.data.workspaceId is string && isValidId(request.resource.data.workspaceId))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
          request.resource.data.status in ['Active', 'Suspended']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) ||
          (request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 64))
      );
      allow delete: if isPlatformAdmin();
    }

    // Client Projects and production records (Phase 3C)
    match /clientProjects/{projectId} {
      allow get, list: if isProjectAdmin() || ownsProject(projectId);
      allow create: if isProjectAdmin() &&
        validProjectDocument(projectId, request.resource.data, true);
      allow update: if isProjectAdmin() &&
        validProjectDocument(
          projectId,
          request.resource.data,
          request.resource.data.keys().hasAny(['workspaceId']) &&
            (!resource.data.keys().hasAny(['workspaceId']) || request.resource.data.workspaceId != resource.data.workspaceId)
        );
      allow delete: if false;

      match /admin/{privateDocId} {
        allow read: if isProjectAdmin();
        allow create, update: if isProjectAdmin() &&
          (!request.resource.data.keys().hasAny(['assignedToUid']) ||
            request.resource.data.assignedToUid == '' ||
            exists(/databases/$(database)/documents/users/$(request.resource.data.assignedToUid)));
        allow delete: if false;
      }

      match /tasks/{taskId} {
        allow read: if isProjectAdmin() ||
          (ownsProject(projectId) &&
            resource.data.projectId == projectId &&
            resource.data.clientUid == request.auth.uid &&
            resource.data.clientVisible == true);
        allow create, update: if isProjectAdmin() &&
          validProductionTask(projectId, taskId, request.resource.data);
        allow delete: if false;

        match /admin/{privateDocId} {
          allow read: if isProjectAdmin();
          allow create, update: if isProjectAdmin() &&
            exists(/databases/$(database)/documents/clientProjects/$(projectId)/tasks/$(taskId)) &&
            (!request.resource.data.keys().hasAny(['assigneeUid']) ||
              request.resource.data.assigneeUid == '' ||
              exists(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)));
          allow delete: if false;
        }
      }

      match /deliverables/{deliverableId} {
        allow read: if isProjectAdmin() ||
          (ownsProject(projectId) &&
            resource.data.projectId == projectId &&
            resource.data.clientUid == request.auth.uid &&
            resource.data.isClientPublished == true);
        allow create, update: if isProjectAdmin() &&
          validProductionDeliverable(projectId, deliverableId, request.resource.data);
        allow delete: if false;
      }

      match /revisionRequests/{revisionId} {
        allow get, list: if isProjectAdmin() ||
          (ownsProject(projectId) &&
            resource.data.projectId == projectId &&
            resource.data.clientUid == request.auth.uid);
        allow create: if isProjectAdmin() &&
          validProductionRevision(projectId, revisionId, request.resource.data);
        allow update: if isProjectAdmin() &&
          request.resource.data.projectId == resource.data.projectId &&
          request.resource.data.clientUid == resource.data.clientUid &&
          request.resource.data.deliverableId == resource.data.deliverableId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'adminResponse', 'updatedAt']) &&
          request.resource.data.status in ['Submitted', 'In Progress', 'Completed', 'Cancelled'];
        allow delete: if false;
      }

      match /internalNotes/{noteId} {
        allow read, write: if isProjectAdmin();
      }

      match /activity/{activityId} {
        allow read: if isProjectAdmin() ||
          (ownsProject(projectId) &&
            resource.data.projectId == projectId &&
            resource.data.clientVisible == true);
        allow create: if isProjectAdmin() &&
          request.resource.data.projectId == projectId &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.keys().hasOnly([
            'id', 'projectId', 'actorUid', 'actorName', 'action', 'details',
            'clientVisible', 'createdAt'
          ]) &&
          request.resource.data.actorName is string &&
          request.resource.data.action is string &&
          request.resource.data.details is string &&
          request.resource.data.details.size() <= 5000 &&
          request.resource.data.clientVisible is bool &&
          request.resource.data.createdAt is string;
        allow update, delete: if false;
      }
    }

    // Collection-group reads power the admin review queue across client projects.
    // Keep these queries admin-only; direct per-project client reads remain governed above.
    match /{parentPath=**}/deliverables/{deliverableId} {
      allow get, list: if isProjectAdmin();
    }

    match /{parentPath=**}/revisionRequests/{revisionId} {
      allow get, list: if isProjectAdmin();
    }

    match /{parentPath=**}/campaignDesigns/{designId} {
      allow get, list: if isPlatformAdmin();
    }

    match /{parentPath=**}/internalAssets/{assetId} {
      allow get, list: if isPlatformAdmin();
    }

    match /{parentPath=**}/brandAssets/{assetId} {
      allow get, list: if isPlatformAdmin();
    }

    match /productionTasks/{taskId} {
      allow get, list: if isProjectAdmin();
      allow create, update: if isProjectAdmin() &&
        (!request.resource.data.keys().hasAny(['projectId']) ||
          (request.resource.data.projectId is string &&
            exists(/databases/$(database)/documents/clientProjects/$(request.resource.data.projectId)) &&
            request.resource.data.clientUid ==
              get(/databases/$(database)/documents/clientProjects/$(request.resource.data.projectId)).data.clientUid)) &&
        request.resource.data.title is string &&
        request.resource.data.status in ['Todo', 'In Progress', 'In Review', 'Done'] &&
        request.resource.data.clientVisible is bool;
      allow delete: if false;

      match /admin/{privateDocId} {
        allow read: if isProjectAdmin();
        allow create, update: if isProjectAdmin() &&
          (!request.resource.data.keys().hasAny(['assigneeUid']) ||
            request.resource.data.assigneeUid == '' ||
            exists(/databases/$(database)/documents/users/$(request.resource.data.assigneeUid)));
        allow delete: if false;
      }
    }

    // Client Deliverables (Phase 2A + 2C + 2C.2)
    // Clients can only update feedback. Review status, approval, and version changes are handled by trusted backend (Cloud Functions) or admin.
    match /clientDeliverables/{deliverableId} {
      allow read: if isPlatformAdmin() ||
        (isWorkspaceAccountActive() && resource.data.clientUid is string && resource.data.clientUid == request.auth.uid);
      allow create: if isPlatformAdmin();
      allow update: if isPlatformAdmin() ||
        (isWorkspaceAccountActive() && resource.data.clientUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback']));
      allow delete: if isPlatformAdmin();
    }

    // Revision Requests (Phase 2C + 2C.2)
    // Clients CANNOT create, update, or delete revision requests directly.
    // All creation is handled by trusted Cloud Functions (requestRevision).
    // All updates are handled by authorized admins or trusted backend.
    match /revisionRequests/{requestId} {
      allow read: if isPlatformAdmin() ||
        (isWorkspaceAccountActive() && resource.data.clientUid is string && resource.data.clientUid == request.auth.uid);
      allow create: if false; // Only Cloud Functions (Admin SDK) can create
      allow update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // Client Notifications (Phase 2A)
    match /clientNotifications/{notificationId} {
      allow read: if isPlatformAdmin() ||
        (isWorkspaceAccountActive() && resource.data.clientUid is string && resource.data.clientUid == request.auth.uid);
      allow create: if isPlatformAdmin();
      allow update: if isWorkspaceAccountActive() &&
        resource.data.clientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read is bool;
      allow delete: if isPlatformAdmin();
    }

    match /userNotifications/{uid}/items/{notificationId} {
      allow get, list: if isOwner(uid) && isWorkspaceAccountActive();
      allow create, delete: if false;
      allow update: if isOwner(uid) &&
        isWorkspaceAccountActive() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']) &&
        request.resource.data.read is bool &&
        request.resource.data.updatedAt is string;
    }

    // Public active services; catalog writes are restricted to audited Cloud Functions.
    match /services/{serviceId} {
      allow read: if isPlatformAdmin() || resource.data.isActive == true;
      allow write: if false;
    }

    function isArtistAccountType(rawType) {
      return rawType is string && rawType.trim().lower() == 'artist';
    }

    function isBrandAccountType(rawType) {
      return rawType is string &&
        rawType.trim().lower() in [
          'brand', 'company', 'business', 'label', 'agency',
          'enterprise', 'personal', 'startup', 'corporation', 'commercial'
        ];
    }

    function clientMatchesProductAudience(audience) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.onboardingComplete == true &&
        (
          audience == 'Shared' ||
          (isArtistAccountType(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.accountType) &&
            audience == 'Artist') ||
          (isBrandAccountType(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.accountType) &&
            audience in ['Brand', 'Business', 'Brand & Business'])
        );
    }

    function clientHasOpenWorkspace() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId is string &&
        isValidId(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId) &&
        isWorkspaceOpen(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId) &&
        (
          ownsProjectWorkspace(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId) ||
          (
            exists(/databases/$(database)/documents/workspaces/$(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)/memberships/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/workspaces/$(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)/memberships/$(request.auth.uid)).data.status == 'Active'
          )
        );
    }

    function clientHasWorkspaceAccessToProduct(assignedWorkspaceIds) {
      return clientHasOpenWorkspace() &&
        get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId in assignedWorkspaceIds;
    }

    function isServicePackageActive(packageId) {
      return packageId is string &&
        isValidId(packageId) &&
        exists(/databases/$(database)/documents/services/$(packageId)) &&
        get(/databases/$(database)/documents/services/$(packageId)).data.isActive == true;
    }

    function clientMatchesPackageAt(productPkgIds, wsPkgIds, idx) {
      return wsPkgIds.size() > idx &&
        wsPkgIds[idx] is string &&
        wsPkgIds[idx].size() > 0 &&
        (wsPkgIds[idx] in productPkgIds) &&
        isServicePackageActive(wsPkgIds[idx]);
    }

    function clientHasPackageEntitlementForProduct(productPkgIds) {
      return clientHasOpenWorkspace() &&
        get(/databases/$(database)/documents/workspaces/$(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.keys().hasAny(['contractedPackageIds']) &&
        get(/databases/$(database)/documents/workspaces/$(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds is list &&
        get(/databases/$(database)/documents/workspaces/$(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds.size() > 0 &&
        (
          clientMatchesPackageAt(productPkgIds, get(/databases/$(database)/documents/workspaces/$(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds, 0) ||
          clientMatchesPackageAt(productPkgIds, get(/databases/$(database)/documents/workspaces/$(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds, 1) ||
          clientMatchesPackageAt(productPkgIds, get(/databases/$(database)/documents/workspaces/$(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds, 2) ||
          clientMatchesPackageAt(productPkgIds, get(/databases/$(database)/documents/workspaces/$(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds, 3) ||
          clientMatchesPackageAt(productPkgIds, get(/databases/$(database)/documents/workspaces/$(get(/databases/$(database)/documents/clientProfiles/$(request.auth.uid)).data.workspaceId)).data.contractedPackageIds, 4)
        );
    }

    function validCreativeProduct(productId, data) {
      return data.keys().hasOnly([
          'id', 'title', 'slug', 'audience', 'productFamily', 'category', 'subcategory', 'summary',
          'description', 'status', 'accessType', 'assignedWorkspaceIds',
          'includedPackageIds', 'linkedServiceCategory', 'version',
          'supportedFormats', 'deliverablesSummary', 'dimensionSpecs',
          'previewImageUrl', 'previewStoragePath', 'previewAlt', 'files',
          'linkedCanvasDesignId', 'linkedTemplateId', 'featured',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        data.id == productId &&
        isValidId(productId) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 160 &&
        data.audience in ['Artist', 'Brand', 'Business', 'Brand & Business', 'Shared'] &&
        (!data.keys().hasAny(['productFamily']) || (data.productFamily is string && data.productFamily.size() <= 120)) &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 120 &&
        (!data.keys().hasAny(['subcategory']) || (data.subcategory is string && data.subcategory.size() <= 120)) &&
        data.summary is string && data.summary.size() <= 600 &&
        data.description is string && data.description.size() <= 5000 &&
        data.status in ['Draft', 'Published', 'Archived'] &&
        data.accessType in ['Free', 'IncludedInPackage', 'AdminAssigned', 'RequestRequired'] &&
        data.assignedWorkspaceIds is list && data.assignedWorkspaceIds.size() <= 200 &&
        (!data.keys().hasAny(['includedPackageIds']) || (data.includedPackageIds is list && data.includedPackageIds.size() <= 50)) &&
        (data.status != 'Published' ||
          data.accessType != 'IncludedInPackage' ||
          (data.keys().hasAny(['includedPackageIds']) && data.includedPackageIds is list && data.includedPackageIds.size() > 0) ||
          data.assignedWorkspaceIds.size() > 0) &&
        data.linkedServiceCategory is string && data.linkedServiceCategory.size() <= 120 &&
        data.version is string && data.version.size() <= 40 &&
        data.supportedFormats is list && data.supportedFormats.size() <= 20 &&
        data.deliverablesSummary is list && data.deliverablesSummary.size() <= 30 &&
        data.dimensionSpecs is list && data.dimensionSpecs.size() <= 30 &&
        data.previewImageUrl is string && data.previewImageUrl.size() <= 2048 &&
        data.files is list && data.files.size() <= 50 &&
        data.createdAt is string && data.updatedAt is string &&
        data.createdBy is string && data.updatedBy is string;
    }

    // Phase 6 Creative Products Catalog & Deliverables
    match /creativeProducts/{productId} {
      allow read: if isPlatformAdmin() || (
        isWorkspaceAccountActive() &&
        clientHasOpenWorkspace() &&
        resource.data.status == 'Published' &&
        clientMatchesProductAudience(resource.data.audience) &&
        (
          resource.data.accessType in ['Free', 'RequestRequired'] ||
          clientHasWorkspaceAccessToProduct(resource.data.assignedWorkspaceIds) ||
          (
            resource.data.accessType == 'IncludedInPackage' &&
            clientHasPackageEntitlementForProduct(resource.data.includedPackageIds)
          )
        )
      );
      allow create, update: if isPlatformAdmin() && validCreativeProduct(productId, request.resource.data);
      allow delete: if isPlatformAdmin();

      // Strictly admin-only Canvas specs, notes, and internal working source metadata
      match /internalSpecs/{specId} {
        allow read, write: if isPlatformAdmin();
      }
    }

    function validBrandRoomAsset(assetId, data) {
      return data.keys().hasOnly([
          'id', 'title', 'categoryArea', 'topic', 'contentPillarId', 'contentPillarName',
          'seriesId', 'seriesName', 'contentType', 'targetAudience', 'platform',
          'formatId', 'formatLabel', 'dimensions', 'description', 'caption',
          'callToAction', 'hashtags', 'tags', 'status', 'publicationDate',
          'publishedAt', 'publishedUrl', 'assignedTeamMemberUid', 'assignedTeamMemberName',
          'promotionObjective', 'showcaseProjectId', 'showcaseSourceType',
          'masterTemplateId', 'canvasDesignJson', 'previewUrl', 'previewStoragePath',
          'editableSourcePath', 'editableSourceUrl', 'exportedFiles', 'version',
          'versionHistory', 'reuseCount', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ]) &&
        data.id == assetId &&
        isValidId(assetId) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
        data.categoryArea is string && data.categoryArea.size() > 0 && data.categoryArea.size() <= 80 &&
        data.platform is string && data.platform.size() > 0 && data.platform.size() <= 60 &&
        data.status in ['Draft', 'Planned', 'Approved', 'Scheduled', 'Published', 'Archived'] &&
        data.exportedFiles is list && data.exportedFiles.size() <= 50 &&
        data.hashtags is list && data.hashtags.size() <= 30 &&
        data.tags is list && data.tags.size() <= 30 &&
        data.version is number && data.version >= 1 &&
        data.reuseCount is number && data.reuseCount >= 0 &&
        data.createdAt is string && data.updatedAt is string &&
        data.createdBy is string && data.updatedBy is string;
    }

    // Internal KeedoHub Brand Room & Marketing Kit (Strictly Platform Admin Only)
    match /brandRoomIdentity/{identityId} {
      allow read, write: if isPlatformAdmin() && isValidId(identityId);
    }

    match /brandRoomPillars/{pillarId} {
      allow get, list: if isPlatformAdmin();
      allow create, update: if isPlatformAdmin() &&
        isValidId(pillarId) &&
        request.resource.data.id == pillarId &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120;
      allow delete: if isPlatformAdmin() && isValidId(pillarId);
    }

    match /brandRoomSeries/{seriesId} {
      allow get, list: if isPlatformAdmin();
      allow create, update: if isPlatformAdmin() &&
        isValidId(seriesId) &&
        request.resource.data.id == seriesId &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120;
      allow delete: if isPlatformAdmin() && isValidId(seriesId);
    }

    match /brandRoomAssets/{assetId} {
      allow get, list: if isPlatformAdmin();
      allow create, update: if isPlatformAdmin() &&
        isValidId(assetId) &&
        validBrandRoomAsset(assetId, request.resource.data);
      allow delete: if isPlatformAdmin() && isValidId(assetId);
    }

    // Server-Governed Commercial Billing & Proposals (Phase 2)
    // Clients can only read non-draft records scoped to their own open workspace.
    // All creations, edits, manual payments, and client proposal responses MUST go through Cloud Functions.
    match /invoices/{invoiceId} {
      allow get, list: if isPlatformAdmin() || (
        isWorkspaceAccountActive() &&
        resource.data.clientUid == request.auth.uid &&
        resource.data.workspaceId is string &&
        isWorkspaceOpen(resource.data.workspaceId) &&
        resource.data.status in ['Issued', 'Partially Paid', 'Paid', 'Overdue', 'Void']
      );
      allow get: if isPlatformAdmin() || (
        isWorkspaceAccountActive() &&
        resource.data.workspaceId is string &&
        isWorkspaceMember(resource.data.workspaceId) &&
        resource.data.status in ['Issued', 'Partially Paid', 'Paid', 'Overdue', 'Void']
      );
      allow create, update, delete: if false;
    }

    match /proposals/{proposalId} {
      allow get, list: if isPlatformAdmin() || (
        isWorkspaceAccountActive() &&
        resource.data.clientUid == request.auth.uid &&
        resource.data.workspaceId is string &&
        isWorkspaceOpen(resource.data.workspaceId) &&
        resource.data.status in ['Issued', 'Sent', 'Under Review', 'Revision Requested', 'Approved', 'Declined', 'Expired']
      );
      allow get: if isPlatformAdmin() || (
        isWorkspaceAccountActive() &&
        resource.data.workspaceId is string &&
        isWorkspaceMember(resource.data.workspaceId) &&
        resource.data.status in ['Issued', 'Sent', 'Under Review', 'Revision Requested', 'Approved', 'Declined', 'Expired']
      );
      allow create, update, delete: if false;
    }
  }
}
